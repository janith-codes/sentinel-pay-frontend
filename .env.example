# ---------------------------------------------------------------------------
# SentinelPay frontend configuration
# ---------------------------------------------------------------------------
# Copy to `.env.local` and adjust. `.env.local` is gitignored.

# Base URL of the Spring Boot API, as seen from the Next.js *server*.
#
# Deliberately not prefixed with NEXT_PUBLIC_: the browser never calls the
# Spring Boot API directly. Requests go to this Next.js server, which attaches
# the access token and forwards them (see src/lib/api/server-client.ts). That
# keeps the JWT out of JavaScript's reach and means the backend needs no CORS
# configuration.
SENTINELPAY_API_BASE_URL=http://localhost:8080

# Set to `true` when serving the frontend over HTTPS so the session cookies are
# issued with the `Secure` attribute. Leave unset for local HTTP development.
# SENTINELPAY_COOKIE_SECURE=true
